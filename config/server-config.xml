<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <!-- Active Directory Configuration -->
  <ActiveDirectory>
    <Domain>havgap-camping.no</Domain>
    <ForestFunctionalLevel>2025</ForestFunctionalLevel>
    <DomainFunctionalLevel>2025</DomainFunctionalLevel>
    <SafeModePassword>ChangeMe@12345</SafeModePassword>
  </ActiveDirectory>

  <!-- Server Configuration -->
  <Server>
    <ComputerName>DC01</ComputerName>
    <Description>Primary Domain Controller - havgap-camping.no</Description>
  </Server>

  <!-- Network Configuration -->
  <Network>
    <StaticIP>192.168.5.10</StaticIP>
    <SubnetMask>255.255.255.0</SubnetMask>
    <Gateway>192.168.5.1</Gateway>
    <PrimaryDNS>192.168.5.10</PrimaryDNS>
    <SecondaryDNS>8.8.8.8</SecondaryDNS>
    <NetworkInterface>Ethernet</NetworkInterface>
  </Network>

  <!-- DHCP Configuration -->
  <DHCP>
    <Enabled>true</Enabled>
    <ScopeName>MainNetwork</ScopeName>
    <StartRange>192.168.5.100</StartRange>
    <EndRange>192.168.5.200</EndRange>
    <SubnetMask>255.255.255.0</SubnetMask>
    <Gateway>192.168.5.1</Gateway>
    <!-- Lease duration in seconds (e.g., 172800 seconds = 2 days) -->
    <LeaseDuration>172800</LeaseDuration>
  </DHCP>

  <!-- DNS Configuration -->
  <DNS>
    <Enabled>true</Enabled>
    <Zone>havgap-camping.no</Zone>
    <ReverseZone>5.168.192.in-addr.arpa</ReverseZone>
  </DNS>

  <!-- IIS Configuration -->
  <IIS>
    <Enabled>true</Enabled>
    <Features>
      <Feature>Web-Server</Feature>
      <Feature>Web-Http-Errors</Feature>
      <Feature>Web-Static-Content</Feature>
      <Feature>Web-Default-Doc</Feature>
      <Feature>Web-Asp-Net</Feature>
      <Feature>Web-Asp-Net45</Feature>
    </Features>
  </IIS>

  <!-- Shared Folders Configuration -->
  <SharedFolders>
    <Folder>
      <Name>Public</Name>
      <Path>D:\Shares\Public</Path>
      <Permission>Everyone:Read</Permission>
    </Folder>
    <Folder>
      <Name>IT</Name>
      <Path>D:\Shares\IT</Path>
      <Permission>IT:ReadWrite</Permission>
    </Folder>
    <Folder>
      <Name>Finance</Name>
      <Path>D:\Shares\Finance</Path>
      <Permission>Finance:ReadWrite</Permission>
    </Folder>
    <Folder>
      <Name>HR</Name>
      <Path>D:\Shares\HR</Path>
      <Permission>HR:ReadWrite</Permission>
    </Folder>
  </SharedFolders>

  <!-- Group Policy Configuration -->
  <GroupPolicy>
    <!-- Password Policy -->
    <PasswordPolicy>
      <MaximumPasswordAge>0</MaximumPasswordAge>
      <MinimumPasswordLength>0</MinimumPasswordLength>
      <RequireComplexity>false</RequireComplexity>
    </PasswordPolicy>
    
    <!-- Security Policy -->
    <SecurityPolicy>
      <DisableCtrlAltDel>true</DisableCtrlAltDel>
      <DisableLockScreen>true</DisableLockScreen>
    </SecurityPolicy>

    <!-- Drive Mappings -->
    <DriveMappings>
      <Mapping>
        <DriveLetter>Z:</DriveLetter>
        <Path>\\DC01\Public</Path>
        <Label>Public Share</Label>
      </Mapping>
    </DriveMappings>
  </GroupPolicy>

  <!-- Organizational Units Structure -->
  <OUStructure>
    <OU>
      <Name>Computers</Name>
      <Parent>DC=havgap-camping,DC=no</Parent>
    </OU>
    <OU>
      <Name>Users</Name>
      <Parent>DC=havgap-camping,DC=no</Parent>
      <SubOU>
        <Name>IT</Name>
      </SubOU>
      <SubOU>
        <Name>Finance</Name>
      </SubOU>
      <SubOU>
        <Name>HR</Name>
      </SubOU>
    </OU>
    <OU>
      <Name>Groups</Name>
      <Parent>DC=havgap-camping,DC=no</Parent>
    </OU>
    <OU>
      <Name>Servers</Name>
      <Parent>DC=havgap-camping,DC=no</Parent>
    </OU>
  </OUStructure>

  <!-- Security Groups -->
  <SecurityGroups>
    <Group>
      <Name>Domain Admins</Name>
      <Scope>Global</Scope>
      <Type>Security</Type>
    </Group>
    <Group>
      <Name>IT</Name>
      <Scope>Global</Scope>
      <Type>Security</Type>
    </Group>
    <Group>
      <Name>Finance</Name>
      <Scope>Global</Scope>
      <Type>Security</Type>
    </Group>
    <Group>
      <Name>HR</Name>
      <Scope>Global</Scope>
      <Type>Security</Type>
    </Group>
  </SecurityGroups>

  <!-- Logging -->
  <Logging>
    <LogDirectory>.\logs</LogDirectory>
    <LogLevel>Verbose</LogLevel>
    <EnableConsoleOutput>true</EnableConsoleOutput>
  </Logging>
</Configuration>
